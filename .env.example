# Copie para .env (o .env NÃO vai para o Git) e preencha.

# ID da agenda "Espelho" (Google Agenda > Configurações da agenda > Integrar agenda > ID da agenda)
AGENDA_GCAL_ID=

# Arquivo JSON da conta de serviço (padrão: data/google-credenciais.json)
# AGENDA_GCAL_CRED=data/google-credenciais.json

# Endereço do app (usado no link "abrir no app" dos eventos)
AGENDA_URL=https://magicmirror.SEU-TAILNET.ts.net
